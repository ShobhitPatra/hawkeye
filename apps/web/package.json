{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "db:generate": "drizzle-kit generate",
    "auth:generate": "auth generate --config src/auth.cli.ts --output src/db/auth-schema.ts -y && node scripts/auth-timestamptz.mjs",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts"
  },
  "dependencies": {
    "@hawkeye/core": "workspace:*",
    "better-auth": "1.7.1",
    "drizzle-orm": "^0.45.2",
    "next": "^16.3.2",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "auth": "1.7.1",
    "drizzle-kit": "^0.31.10"
  }
}
