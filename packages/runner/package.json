{
  "name": "hawkeye-review",
  "version": "0.9.0",
  "description": "Code review on the AI subscription you already pay for.",
  "keywords": [
    "ai-agents",
    "ai-code-review",
    "claude-code",
    "cli",
    "code-review",
    "codex",
    "developer-tools",
    "llm",
    "pull-requests"
  ],
  "homepage": "https://github.com/ShobhitPatra/hawkeye#readme",
  "bugs": "https://github.com/ShobhitPatra/hawkeye/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShobhitPatra/hawkeye.git",
    "directory": "packages/runner"
  },
  "bin": {
    "hawkeye": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/bin.ts",
    "prepack": "cp ../../LICENSE LICENSE",
    "prepublishOnly": "pnpm --filter @hawkeye/core build && pnpm run build"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@hawkeye/core": "workspace:*"
  },
  "engines": {
    "node": ">=22.12"
  }
}
