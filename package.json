{
  "name": "hawkeye-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "build": "pnpm -r build",
    "readme": "tsx --tsconfig packages/runner/tsconfig.json packages/runner/scripts/write-readme.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "pnpm@11.11.0"
}
