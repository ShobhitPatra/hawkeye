{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "ignorePatterns": ["dist", "workspace"],
  "overrides": [
    {
      "files": ["packages/core/src/worktree/worktree.ts"],
      "rules": {
        "preserve-caught-error": "off"
      }
    }
  ]
}
