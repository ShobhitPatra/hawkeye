{
  "name": "hawkeye-review",
  "version": "0.1.0",
  "description": "Personal AI code reviewer on the Claude plan you already pay for: review pull requests locally, or run the Hawkeye daemon.",
  "keywords": [
    "ai",
    "claude",
    "claude-code",
    "code-review",
    "pull-request"
  ],
  "homepage": "https://github.com/ShobhitPatra/hawkeye#readme",
  "bugs": "https://github.com/ShobhitPatra/hawkeye/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShobhitPatra/hawkeye.git",
    "directory": "packages/runner"
  },
  "bin": {
    "hawkeye": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/bin.ts"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@hawkeye/core": "workspace:*"
  },
  "engines": {
    "node": ">=22.12"
  }
}
