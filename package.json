{
  "name": "hawkeye-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "build": "pnpm -r build",
    "readme": "tsx --tsconfig packages/runner/tsconfig.json packages/runner/scripts/write-readme.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@11.11.0"
}
